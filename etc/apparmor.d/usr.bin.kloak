/usr/bin/kloak {
  include <local/usr.bin.kloak>

  signal receive set=cont peer=unconfined,
  signal receive set=exists peer=unconfined,
  signal receive set=kill peer=unconfined,
  signal receive set=term peer=unconfined,

  /etc/ld.so.cache r,
  /etc/ld.so.preload r,
  /usr/bin/kloak mr,
  /usr/bin/kloakwl rPx -> /usr/bin/kloakwl,
  /{,usr/}lib{,32,64}/** mr,
  /dev/input/ r,
  /dev/input/event* rw,
  /dev/shm/* rw,
  /dev/urandom r,

  ## libinput needs these.
  /sys/devices/**/uevent r,
  /run/udev/data/* r,
  /usr/share/libinput/ r,
  /usr/share/libinput/* r,
}
