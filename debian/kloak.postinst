#!/bin/bash

## Copyright (C) 2012 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## style-ok: no-strict -- package maintainer script.

if [ -f /usr/libexec/helper-scripts/pre.bsh ]; then
   source /usr/libexec/helper-scripts/pre.bsh
fi

set -o errexit
export LC_ALL=C

true "
#####################################################################
## INFO: BEGIN: ${DPKG_MAINTSCRIPT_PACKAGE:-} ${DPKG_MAINTSCRIPT_NAME:-} $*
#####################################################################
"

case "$1" in
  configure)
    adduser \
      --no-create-home \
      --home /nonexistent \
      --quiet --system --group kloakwl || true
    ;;

  abort-upgrade|abort-remove|abort-deconfigure)
    ;;

  *)
    printf '%s\n' "$DPKG_MAINTSCRIPT_NAME called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

true "INFO: debhelper beginning here."

#DEBHELPER#

true "INFO: Done with debhelper."

true "
#####################################################################
## INFO: END  : ${DPKG_MAINTSCRIPT_PACKAGE:-} ${DPKG_MAINTSCRIPT_NAME:-} $*
#####################################################################
"

## Explicitly "exit 0", so eventually trapped errors can be ignored.
exit 0
